<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground · 108 × 108 dp canvas
  Safe zone: 72 × 72 dp (18 dp inset on each side), centered at (54, 54)

  Design:
    - Bold white phone handset centered in the safe zone
    - Cyan (#22D3EE) 4-pointed star sparkle — top-right
    - Smaller cyan sparkle — bottom-left
    - Tiny cyan dot — lower-right
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Phone handset (Material filled phone icon, original 24×24 viewport).
      Scaled 2× → 48 dp.  Translated so the glyph is visually centered at (54,54).
      Glyph occupies roughly x:[2,21] y:[2,21] in 24vp → after ×2 → [4,42].
      We shift by (54 − 23) = 31 to center the 42 dp span.
    -->
    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="31"
        android:translateY="31">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="
M6.62,10.79
c1.44,2.83 3.76,5.14 6.59,6.59
l2.2,-2.2
c0.27,-0.27 0.67,-0.36 1.02,-0.24
c1.12,0.37 2.33,0.57 3.57,0.57
c0.55,0 1,0.45 1,1
V20
c0,0.55 -0.45,1 -1,1
c-9.39,0 -17,-7.61 -17,-17
c0,-0.55 0.45,-1 1,-1
h3.5
c0.55,0 1,0.45 1,1
c0,1.25 0.2,2.45 0.57,3.57
c0.11,0.35 0.03,0.74 -0.25,1.02
Z" />
    </group>

    <!--
      Cyan 4-pointed star — top-right  (cx=80, cy=26, outer=6, inner=2.4)
      Points: top(80,20) right(86,26) bottom(80,32) left(74,26)
      Inner: (82.4,23.6) (82.4,28.4) (77.6,28.4) (77.6,23.6)
    -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="
M80,20
L82.4,23.6
L86,26
L82.4,28.4
L80,32
L77.6,28.4
L74,26
L77.6,23.6
Z" />

    <!--
      Smaller cyan 4-pointed star — bottom-left  (cx=28, cy=79, outer=4, inner=1.6)
    -->
    <path
        android:fillColor="#22D3EE"
        android:fillAlpha="0.85"
        android:pathData="
M28,75
L29.6,77.4
L32,79
L29.6,80.6
L28,83
L26.4,80.6
L24,79
L26.4,77.4
Z" />

    <!--
      Tiny cyan diamond dot — right side  (cx=86, cy=58, size=2.5)
    -->
    <path
        android:fillColor="#22D3EE"
        android:fillAlpha="0.6"
        android:pathData="
M86,55.5
L88.5,58
L86,60.5
L83.5,58
Z" />

</vector>